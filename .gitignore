#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter SDK embebido en el proyecto (no debe subirse)
/flutter/

# Artefactos de build de Android no cubiertos por android/.gitignore
android/build/
android/.kotlin/

# Local review tools, credentials and runtime data
/.review/
/.tools/
.env
.env.*
!.env.example
*.hive
*.hive.lock
*.sqlite
